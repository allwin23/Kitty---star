{
  "manifest_version": 3,
  "name": "Focus Lock",
  "version": "1.0.0",
  "description": "Cross-device focus companion for Kitty & Star (Chromium Decoupled Edition)",
  "permissions": [
    "declarativeNetRequest",
    "alarms",
    "storage",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "dist/content/youtube.js"
      ],
      "run_at": "document_start"
    }
  ]
}
