{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["background/**/*", "blocking/**/*", "ui/**/*", "shared/**/*", "global.d.ts"],
  "exclude": ["__tests__/**/*", "dist"]
}
